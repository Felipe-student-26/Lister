VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Correo al que apunta "contactar al administrador" en el login
VITE_ADMIN_EMAIL=
# Bloqueo de intentos en servidor (Cloud Functions loginGate/loginAttempt + beforeSignIn). Ver README.
VITE_USE_SERVER_LOCK=false
VITE_FUNCTIONS_REGION=us-central1
# true = usa el emulador de Functions en 127.0.0.1:5001
VITE_FUNCTIONS_EMULATOR=false
# true = intenta passkeys también dentro de Capacitor (depende del WebView; sin verificar)
VITE_PASSKEY_NATIVE=false

# auto (por defecto): celular = sesión permanente, PC = pide iniciar sesión al abrir. true/false fuerza el comportamiento.
VITE_KEEP_SESSION=

# URL pública de la app (la que va en el enlace del formulario de anamnesis). Vacío = https://<proyecto>.web.app
VITE_PUBLIC_URL=
