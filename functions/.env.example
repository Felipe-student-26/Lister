# Clave "Web API Key" del proyecto (Configuración del proyecto → General). Se usa en el servidor
# para verificar la contraseña con Identity Toolkit (accounts:signInWithPassword).
WEB_API_KEY=
# Solo si la clave tiene restricción por "HTTP referrer": origen permitido que se enviará como Referer.
WEB_API_REFERER=
# Orígenes desde los que se permiten passkeys (separados por coma). rpID = hostname de cada origen.
PASSKEY_ORIGINS=https://TU-PROYECTO.web.app,http://localhost:5173
RP_NAME=Lister
